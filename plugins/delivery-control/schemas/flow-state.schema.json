{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Control flow state",
  "type": "object",
  "required": ["flow_id", "revision", "flow", "status", "current_phase", "next_phase", "plan_target", "terminal_condition", "resume_point", "review_findings"],
  "properties": {
    "flow_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "flow": {"enum": ["main", "bug", "triage", "wayfinder", "maintenance", "direct"]},
    "status": {"enum": ["active", "awaiting-user", "blocked-external", "partial", "failed", "complete", "cancelled"]},
    "current_phase": {"enum": ["route", "setup", "clarify", "prototype", "spec", "tickets", "goal", "execute", "review", "close"]},
    "next_phase": {"oneOf": [{"enum": ["route", "setup", "clarify", "prototype", "spec", "tickets", "goal", "execute", "review", "close"]}, {"const": "none"}]},
    "plan_target": {"type": "string"},
    "terminal_condition": {"type": "string", "minLength": 1},
    "resume_point": {"type": "string", "minLength": 1},
    "review_findings": {"type": "array", "items": {"type": "object", "required": ["finding_id", "severity", "disposition"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "severity": {"enum": ["P0", "P1", "P2", "P3"]}, "disposition": {"enum": ["open", "fixed", "accepted", "deferred"]}, "reason": {"type": ["string", "null"]}, "reverified_by": {"type": ["string", "null"]}}}},
    "terminal_observation": {"type": ["object", "null"], "required": ["evidence_id", "artifact", "artifact_digest", "observed_at", "result"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "artifact": {"type": "string", "minLength": 1}, "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "observed_at": {"type": "string", "format": "date-time"}, "result": {"enum": ["passed", "verified", "accepted", "observed"]}}}
  }
}
