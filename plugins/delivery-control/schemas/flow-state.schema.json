{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Control flow state",
  "type": "object",
  "required": [
    "flow_id",
    "revision",
    "flow",
    "status",
    "current_phase",
    "next_phase",
    "plan_target",
    "terminal_condition",
    "resume_point",
    "delivery_generation",
    "scope_digest",
    "fixed_point",
    "mode",
    "policy_id",
    "policy_version",
    "policy_digest"
  ],
  "properties": {
    "flow_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "flow": {
      "enum": [
        "main",
        "bug",
        "triage",
        "wayfinder",
        "maintenance",
        "direct"
      ]
    },
    "status": {
      "enum": [
        "active",
        "awaiting-user",
        "blocked-external",
        "partial",
        "failed",
        "complete",
        "cancelled"
      ]
    },
    "current_phase": {
      "enum": [
        "route",
        "setup",
        "clarify",
        "prototype",
        "spec",
        "tickets",
        "goal",
        "execute",
        "review",
        "close"
      ]
    },
    "next_phase": {
      "enum": [
        "route",
        "setup",
        "clarify",
        "prototype",
        "spec",
        "tickets",
        "goal",
        "execute",
        "review",
        "close",
        "none"
      ]
    },
    "plan_target": {
      "type": "string",
      "minLength": 1
    },
    "terminal_condition": {
      "type": "string",
      "minLength": 1
    },
    "resume_point": {
      "type": "string",
      "minLength": 1
    },
    "delivery_generation": {
      "type": "integer",
      "minimum": 1
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "standard",
        "strict"
      ]
    },
    "policy_id": {
      "const": "com.1clipse.policy-driven-delivery-protocol"
    },
    "policy_version": {
      "const": "3.0.0"
    },
    "policy_digest": {
      "const": "sha256:b19e75275115e6dc0343fb2db5751b41b05d39da6db59a41544575dfd006aeb7"
    },
    "fixed_point": {
      "type": "object",
      "required": [
        "generation",
        "spec_digest",
        "implementation_digest",
        "review_digest"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "spec_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
