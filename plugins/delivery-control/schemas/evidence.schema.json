{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery evidence",
  "type": "object",
  "required": ["evidence_id", "acceptance_ids", "type", "result", "artifact", "artifact_digest", "command_or_request_id", "observed_at", "producer", "environment"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "acceptance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "type": {"type": "string", "minLength": 1},
    "result": {"enum": ["passed", "verified", "accepted", "observed"]},
    "artifact": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "command_or_request_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
