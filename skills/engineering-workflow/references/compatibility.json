{
  "schema_version": "3.0.0",
  "policy": {
    "policy_id": "com.1clipse.policy-driven-delivery-protocol",
    "minimum_schema_version": "3.0.0",
    "authority": "plugins/delivery-control/schemas/workflow-policy.json",
    "generated_state_machine": "references/state-machine.json",
    "modes": ["standard", "strict"]
  },
  "delivery_control": {
    "minimum_version": "3.0.0",
    "plugin_name": "delivery-control",
    "public_tools": [
      "start_or_resume_flow",
      "route_flow",
      "checkpoint_flow",
      "record_evidence",
      "authorize_external_action",
      "audit_or_recover_flow",
      "close_or_cancel_flow"
    ],
    "legacy_tools": [
      "initialize_flow",
      "inspect_flow",
      "select_route",
      "advance_phase",
      "revise_scope",
      "recover_flow",
      "project_native_plan",
      "confirm_native_plan",
      "validate_evidence",
      "record_delivery_evidence",
      "record_review_findings",
      "record_external_action_result",
      "request_authorization",
      "confirm_authorization",
      "consume_authorization",
      "audit_consistency",
      "get_metrics",
      "close_flow",
      "cancel_flow"
    ]
  },
  "host_plan": {
    "role": "advisory-runtime-projection",
    "required_for_close": false,
    "fallback": "plan_sync unavailable with explicit handoff"
  },
  "lifecycle_hooks": {
    "role": "opt-in-advisory",
    "events": ["SessionStart", "PreCompact", "Stop"],
    "writes_state": false,
    "fallback": "manual audit/recover, handoff checkpoint, and close gate"
  },
  "host_capabilities_file": "references/host-capabilities.json",
  "plan_tree": {
    "minimum_version": "0.4.0",
    "version_file": "plan-tree/VERSION"
  },
  "ask_matt": {
    "router_file": "ask-matt/SKILL.md",
    "phase_boundaries_file": "ask-matt/PHASE-BOUNDARIES.md",
    "optional_host_operations": ["clear", "compact"],
    "fallback_operation": "handoff"
  },
  "product_design": {
    "plugin_name": "product-design",
    "minimum_version": "0.1.47",
    "router_file": "skills/index/SKILL.md",
    "required_skills": [
      "user-context",
      "get-context",
      "research",
      "audit",
      "ideate",
      "image-to-code",
      "url-to-code",
      "design-qa",
      "share"
    ]
  }
}
